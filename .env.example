# Vite exposes VITE_* values in the public bundle. Never put secrets here.
VITE_API_URL=/api
VITE_COGNITO_AUTHORITY=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
# Public browser key. Restrict it in Google Cloud to Maps JavaScript API,
# Places API (New), and https://money-stalker.vercel.app/*.
VITE_GOOGLE_MAPS_API_KEY=
# Local development only; deployed builds never enable this authentication bypass.
# Start npm run dev and npm run dev:web in separate terminals.
