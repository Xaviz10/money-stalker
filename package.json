{
  "name": "money-stalker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --import tsx server/local.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:secrets": "node scripts/check-repo-safety.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run check:secrets && npm run typecheck && npm test && npm run build",
    "infra:synth": "cdk synth --app 'node --import tsx infra/app.ts' --no-lookups",
    "infra:deploy": "cdk deploy --app 'node --import tsx infra/app.ts' -c deployment=true",
    "phase0": "node --import tsx scripts/phase0.ts",
    "cost": "node --import tsx scripts/cost.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:iphone": "playwright test --config playwright.iphone.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-sqs": "^3.900.0",
    "@aws-sdk/lib-dynamodb": "^3.900.0",
    "@aws-sdk/s3-presigned-post": "^3.900.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "maplibre-gl": "^6.15.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/aws-lambda": "^8.10.155",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "aws-cdk": "^2.1030.0",
    "aws-cdk-lib": "^2.220.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.11",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "5.0.5"
  }
}
